# 统一换行，避免跨平台 diff 噪音
* text=auto

# 配置文件保持 LF，别被 checkout 成 CRLF
.gitattributes text eol=lf
.gitignore     text eol=lf

# 源码统一 LF
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf

# 批处理必须是 CRLF：cmd.exe 对 LF-only 的 .bat 在 goto/括号块上会出问题
*.bat  text eol=crlf

# 二进制，不做换行/文本处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.bmp  binary
*.mp4  binary
*.mkv  binary
